<Window x:Class="SisbackupNativeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sisbackup Client" Height="620" Width="850"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Closing="Window_Closing" Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: Status Bar ═══ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Server Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" Margin="0,0,10,0"
                             VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtStatus" Text="Disconnected" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtServerUrl" Text="Belum terhubung ke server" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Storage Bar -->
                <StackPanel Grid.Column="1" Margin="40,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="StorageBar" Height="10" Minimum="0" Maximum="100" Value="0"
                                     Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="TxtStorage" Grid.Column="1" Text="0 / 0 GB" Margin="10,0,0,0"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnSyncNow" Content="🔄 Sync Now" Style="{StaticResource PrimaryButton}"
                            Click="BtnSyncNow_Click" Width="110" Margin="0,0,6,0"/>
                    <Button x:Name="BtnPause" Content="⏸ Pause" Width="90"
                            Background="#F59E0B" Foreground="White" Padding="12,10" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand" Click="BtnPause_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ ROW 1: Folders + Destinations ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 📁 Folders -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="📁 Folder yang Dibackup" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button Content="+ Tambah" Style="{StaticResource PrimaryButton}" Padding="10,6"
                                    FontSize="12" HorizontalAlignment="Right" Click="BtnAddFolder_Click"/>
                        </Grid>
                    </Border>
                    <ListView x:Name="LstFolders" Grid.Row="1" BorderThickness="0" Margin="0"
                              Background="Transparent" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Path}" FontSize="13" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="⏸" Width="30" Height="24" FontSize="10"
                                                    Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                                                    Tag="{Binding}" Click="BtnToggleFolder_Click"/>
                                            <Button Content="✕" Width="30" Height="24" FontSize="10"
                                                    Foreground="#EF4444" Background="#FEF2F2" BorderThickness="0"
                                                    Cursor="Hand" Tag="{Binding}" Click="BtnRemoveFolder_Click"
                                                    Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ☁️ Destinations -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="☁️ Tujuan Backup" FontWeight="Bold" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button Content="+ Tambah" Style="{StaticResource PrimaryButton}" Padding="10,6"
                                    FontSize="12" HorizontalAlignment="Right" Click="BtnAddDest_Click"/>
                        </Grid>
                    </Border>
                    <ListView x:Name="LstDestinations" Grid.Row="1" BorderThickness="0" Margin="0"
                              Background="Transparent" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="✕" Width="30" Height="24" FontSize="10"
                                                    Foreground="#EF4444" Background="#FEF2F2" BorderThickness="0"
                                                    Cursor="Hand" Tag="{Binding}" Click="BtnRemoveDest_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ ROW 2: Tab Control (Log + Settings) ═══ -->
        <TabControl Grid.Row="2" Margin="0,0,0,10">
            <TabItem Header="📋 Log Sinkronisasi">
                <ListView x:Name="LstLogs" Background="#1E293B" Foreground="#E2E8F0"
                          FontFamily="Consolas" FontSize="12" BorderThickness="0"
                          VirtualizingPanel.ScrollUnit="Pixel"/>
            </TabItem>
            <TabItem Header="⚙️ Pengaturan">
                <ScrollViewer Margin="16">
                    <StackPanel Width="400">
                        <TextBlock Text="Koneksi Server" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Alamat Server Sekolah" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtServerAddress" FontSize="13" Padding="8,6"
                                 Margin="0,0,0,12"/>
                        <TextBlock Text="Username" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUsername" FontSize="13" Padding="8,6"
                                 Margin="0,0,0,12"/>
                        <TextBlock Text="Password" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtPassword" FontSize="13" Padding="8,6"
                                     Margin="0,0,0,16"/>
                        <Button x:Name="BtnConnect" Content="🔗 Hubungkan ke Server" Style="{StaticResource PrimaryButton}"
                                Width="220" Click="BtnConnect_Click"/>

                        <Separator Margin="0,20"/>

                        <TextBlock Text="Pengaturan Aplikasi" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Jalankan saat Windows startup"
                                  FontSize="13" Margin="0,4"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize ke system tray saat close"
                                  FontSize="13" Margin="0,4" IsChecked="True"/>
                        <Button Content="💾 Simpan Pengaturan" Style="{StaticResource PrimaryButton}"
                                Width="200" Margin="0,16,0,0" Click="BtnSaveSettings_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ═══ ROW 3: Footer ═══ -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="TxtFooter" Text="Sisbackup Client v2.7.0 — Ready"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtLastSyncTime" Text="" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
