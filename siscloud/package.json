{
  "name": "siscloud",
  "version": "1.0.0",
  "description": "Siscloud - Cloud sync server for Sisbackup",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "docker:build": "docker build -t siscloud .",
    "docker:run": "docker run -p 3000:3000 --env-file .env siscloud"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@prisma/client": "^5.0.0",
    "next-auth": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "uuid": "^10.0.0",
    "ws": "^8.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "prisma": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.0.0",
    "postcss": "^8.0.0"
  }
}
